<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<featureModel>
	<properties>
		<graphics key="autolayoutconstraints" value="false"/>
		<graphics key="legendautolayout" value="true"/>
		<graphics key="showconstraints" value="true"/>
		<graphics key="showshortnames" value="false"/>
		<graphics key="layout" value="horizontal"/>
		<graphics key="showcollapsedconstraints" value="true"/>
		<graphics key="legendhidden" value="false"/>
		<graphics key="layoutalgorithm" value="1"/>
	</properties>
	<struct>
		<and abstract="true" mandatory="true" name="Proyecto_EHealth_SaaS">
			<and mandatory="true" name="Base">
				<graphics key="collapsed" value="false"/>
				<and mandatory="true" name="Seguridad">
					<feature name="Autenticacion"/>
					<feature name="Control_Roles"/>
					<feature name="Auditoria"/>
				</and>
				<and mandatory="true" name="Gestion_Administrativa">
					<feature mandatory="true" name="Pacientes"/>
					<feature mandatory="true" name="Agenda"/>
					<or name="Notificaciones">
						<feature name="Email"/>
						<feature name="WhatsApp"/>
					</or>
				</and>
				<and mandatory="true" name="Gestion_Clinica">
					<feature mandatory="true" name="Historia_Base"/>
					<alt mandatory="true" name="Especialidad">
						<feature name="Odontologia"/>
						<feature name="Cardiologia"/>
						<feature name="Medicina_General"/>
					</alt>
					<feature name="Telemedicina"/>
					<and name="Receta_Electronica">
						<feature mandatory="true" name="Firma_Digital"/>
					</and>
				</and>
				<and mandatory="true" name="Facturacion">
					<feature mandatory="true" name="Cobro_Manual"/>
					<alt name="Pagos_Online">
						<feature name="Kushki"/>
						<feature name="DeUna"/>
					</alt>
				</and>
			</and>
		</and>
	</struct>
	<constraints>
		<rule>
			<imp>
				<var>Telemedicina</var>
				<var>Pagos_Online</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>Telemedicina</var>
				<not>
					<var>Odontologia</var>
				</not>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>WhatsApp</var>
				<var>Pagos_Online</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>Receta_Electronica</var>
				<var>Email</var>
			</imp>
		</rule>
		<rule>
			<imp>
				<var>DeUna</var>
				<not>
					<var>Cardiologia</var>
				</not>
			</imp>
		</rule>
	</constraints>
</featureModel>
